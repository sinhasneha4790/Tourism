# Copy to .env.local for local development. Never commit .env.local.
# In production, set these in Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=            # e.g. https://mistrail.vercel.app, later the custom domain
NEXT_PUBLIC_WHATSAPP_NUMBER=     # owner supplies, digits with country code, e.g. 919800000000
NEXT_PUBLIC_CONTACT_EMAIL=       # shown in the footer
NEXT_PUBLIC_CONTACT_PHONE=       # shown in the footer
CONTACT_TO_EMAIL=                # where enquiries are sent
CONTACT_FROM_EMAIL=              # verified Resend sender, e.g. "Mistrail <hello@mistrail.in>"
RESEND_API_KEY=                  # phase 2
DATABASE_URL=                    # phase 3 (auto-added by Vercel Marketplace Postgres / Neon)
DATABASE_URL_UNPOOLED=           # optional: direct connection used for migrations (Neon adds it)
AUTH_SECRET=                     # phase 3 (generate: npx auth secret)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
ADMIN_EMAILS=                    # comma-separated emails that get the admin role
BLOB_READ_WRITE_TOKEN=           # phase 3: listing photo uploads (auto-added when you connect Vercel Blob)
CRON_SECRET=                     # phase 5: protects /api/cron/review-requests (Vercel sends it automatically)
# AUTH_TEST_LOGIN=1              # local/CI e2e only — ignored on Vercel
RAZORPAY_KEY_ID=                 # phase 4 — TEST keys only (rzp_test_…)
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=         # set the same secret on the Razorpay webhook (/api/payments/webhook)
# PAYMENTS_LIVE_APPROVED=true    # owner only, after approving go-live; without it rzp_live_ keys are refused
# PAYMENTS_FAKE=1                # local/CI fake gateway — ignored on Vercel
